.claude/settings.local.json
CLAUDE.local.md
.claude/worktrees/
.claude/scheduled_tasks.lock
# macOS Finder metadata, in every directory
.DS_Store
# Python's bytecode caches, from base's own scripts and hooks, in every directory
__pycache__/

# roots: from python
.venv/
__pycache__/
*.pyc
.pytest_cache/
dist/
*.egg-info/

# roots: from the product
build/
